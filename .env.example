# Live flight feed configuration (server side only — never exposed to browsers).
# Copy to .env for local development: node scripts/dev-server.mjs reads it.
# In production, set these as Cloudflare Worker vars (api/wrangler.toml) or,
# for FARM_LATITUDE / FARM_LONGITUDE, as Worker secrets.

FLIGHT_FEED_ENABLED=true
# Fictional demo flights. Must be false in production.
FLIGHT_FEED_DEMO=false

# Farm reference point. Defaults to Imperial Municipal Airport (KIML)
# when unset. Use exact farm coordinates only as secrets.
FARM_LATITUDE=
FARM_LONGITUDE=

FLIGHT_QUERY_RADIUS_NM=50
FLIGHT_DISPLAY_RADIUS_NM=30
FLIGHT_STALE_AFTER_SECONDS=30
FLIGHT_REFRESH_SECONDS=15
FLIGHT_LIVE_CACHE_SECONDS=10
FLIGHT_MAX_DISPLAYED=8

# Browser origins allowed to call the API (comma separated).
FLIGHT_ALLOWED_ORIGINS=https://www.mcnair-farms.com,https://mcnair-farms.com

# Upstream services (defaults shown).
ADSBLOL_BASE_URL=https://api.adsb.lol
ADSBDB_BASE_URL=https://api.adsbdb.com

# Reserved for a future paid route fallback. Server-side secret only.
# FLIGHTAWARE_API_KEY=
