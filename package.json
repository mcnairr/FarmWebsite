{
  "name": "mcnair-farms-website",
  "private": true,
  "description": "McNair Farms Inc. website and live flight feed API",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "demo": "node scripts/dev-server.mjs --demo",
    "plane-art:reference": "node scripts/build-plane-art-reference.mjs",
    "plane-art:prompts": "node scripts/build-plane-prompt-catalog.mjs",
    "plane-art:validate-prompts": "node scripts/validate-plane-prompt-catalog.mjs",
    "plane-art:validate": "node scripts/validate-plane-library.mjs",
    "plane-art:generate": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-plane-library.ps1",
    "plane-art:process": "node scripts/process-plane-art.mjs",
    "plane-art:repair-lighting": "node scripts/repair-plane-lighting.mjs",
    "plane-art:audit-phase1": "node scripts/audit-phase1-plane-art.mjs",
    "test": "node --test \"test/*.test.js\"",
    "test:browser": "playwright test",
    "test:all": "npm run test && npm run test:browser",
    "deploy:api": "npx wrangler@4 deploy --config api/wrangler.toml"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "sharp": "^0.35.5"
  }
}
